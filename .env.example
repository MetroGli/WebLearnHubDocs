# Copia este archivo como ".env" y ajusta los valores antes de levantar el proyecto.

# Dominio con el que vas a acceder a la aplicación (debe apuntar por DNS a la IP de tu VM)
DOMAIN=tudominio.com

# Base de datos PostgreSQL
DB_NAME=learndhub
DB_USER=learndhub
DB_PASSWORD=cambia-esta-clave-por-una-segura
